# ─────────────────────────────────────────────────────────────────────────────
# Lumen backend env vars — copy to backend/.env (gitignored) and fill in.
# Defaults are sensible; only the LLM keys are strictly required to render.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider keys (required) ────────────────────────────────────────────
# Lumen falls through: OpenRouter (free Nemotron) → Groq (free Llama) → Gemini.
# You only NEED one to render, but having all three improves resilience.

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

GROQ_API_KEY=your_groq_key_here
GROQ_PLANNER_MODEL=llama-3.3-70b-versatile
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ops integrations ───────────────────────────────────────────────

# Sentry: leave blank to disable error reporting. SENTRY_TRACES_RATE controls
# performance trace sampling (0.0 = none, 1.0 = all). LUMEN_ENV tags events.
# SENTRY_DSN=
# SENTRY_TRACES_RATE=0.1
# LUMEN_ENV=dev

# ── Rate limiting (Item #18) ────────────────────────────────────────────────
# Per-IP daily quota on heavy endpoints (/ask, /render, /api/direct-lesson*).
# 0 disables the limiter entirely. Defaults to 10 requests / 86400 seconds.
# LUMEN_RATE_LIMIT=10
# LUMEN_RATE_LIMIT_WINDOW_SECONDS=86400

# ── TTS narration (Item #8) ─────────────────────────────────────────────────
# Off by default. Set to 1 to attempt narration via edge-tts → pyttsx3 →
# silent fallback. Requires either `pip install edge-tts` or `pip install
# pyttsx3` for actual audio; otherwise the muxed track is silent.
# LUMEN_TTS_ENABLED=0
# LUMEN_TTS_VOICE=en-US-AriaNeural
